# AI Website Builder - Environment Variables

# OpenAI API Key for website generation
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database URL for Prisma
# Example: postgresql://user:password@localhost:5432/ai_website_builder
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Auth (if using Clerk or Auth.js)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
                                                                   